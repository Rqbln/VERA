# Copy to .env and adjust. Used by API, worker, and local CLI targets.

# Ollama on host: from Docker use host.docker.internal; native Python use 127.0.0.1
OLLAMA_API_BASE=http://127.0.0.1:11434
RAIP_TARGET_MODEL=ollama/ministral-3:3b
# Optional; defaults to RAIP_TARGET_MODEL
# RAIP_JUDGE_MODEL=ollama/ministral-3:3b

REDIS_URL=redis://localhost:6379/0
# TTL for run records in Redis (seconds); 0 = no expiry (default 604800 = 7 days)
REDIS_RUN_TTL_SECONDS=604800
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=raip-mvp1

MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raip
MINIO_REGION=us-east-1

# MLflow S3 artifact store (MinIO) — worker and MLflow container
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1

API_HOST=0.0.0.0
API_PORT=8000

# CLI
RAIP_API_URL=http://127.0.0.1:8000
