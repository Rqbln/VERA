# Copy to .env and adjust. Used by API, worker, and local CLI targets.

# ── Guided / lite mode (no login, local artifacts, no MLflow) ───────────────────────
# Defaults below already imply guided mode; set these to force it for native runs.
VERA_AUTH_MODE=guided                  # guided (no login) | enterprise (Keycloak)
VERA_ARTIFACT_BACKEND=auto             # auto | minio | local
VERA_LOCAL_ARTIFACTS_DIR=./.vera-artifacts
# VERA_MLFLOW_DISABLED=1               # set in lite mode to skip MLflow
# VERA_PUBLIC_API_URL=http://localhost:8000   # browser-reachable API for local artifact links

# Ollama on host: from Docker use host.docker.internal; native Python use 127.0.0.1
OLLAMA_API_BASE=http://127.0.0.1:11434
VERA_TARGET_MODEL=ollama/llama3.1:8b-instruct-q8_0
# Optional; defaults to VERA_TARGET_MODEL
# VERA_JUDGE_MODEL=ollama/llama3.1:8b-instruct-q8_0

REDIS_URL=redis://localhost:6379/0
# TTL for run records in Redis (seconds); 0 = no expiry (default 604800 = 7 days)
REDIS_RUN_TTL_SECONDS=604800
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=vera-mvp2

MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=vera
MINIO_REGION=us-east-1

# MLflow S3 artifact store (MinIO) — worker and MLflow container
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1

API_HOST=0.0.0.0
API_PORT=8000

# CLI
VERA_API_URL=http://127.0.0.1:8000

# Tests: VERA_INTEGRATION=1 (Redis+MinIO), VERA_E2E_OLLAMA=1 (full stack)

# ── Native multi-model evaluation (paper reproduction; docs/EVALUATION_GUIDE.md) ────
# Install the harnesses first: pip install -e '.[benchmarks,lab,pdf]' (or scripts/setup_native.sh)
# VERA_REQUIRE_NATIVE=1               # fail a run if a native-harness benchmark falls back
# VERA_NATIVE_ALLOW=garak             # comma list of impls allowed to fall back anyway (Apple Silicon)
# VERA_HF_TRUST_REMOTE_CODE=true      # allow datasets that ship custom loader code (BBQ/BOLD/StereoSet)
# VERA_WATERMARK_MODE=statistical     # R09 watermark probe mode
# VERA_LM_EVAL_FORCE=1                # attempt native lm-eval on Ollama anyway (no logprobs -> slow)
# VERA_EVAL_MODELS=ollama/qwen2.5:32b-instruct-q4_K_M,ollama/mistral-small:24b,ollama/llama3.1:8b-instruct-q8_0
# VERA_EVAL_N=20                      # items per benchmark for the paper harness
# Banking corpus for R03-R05 is data/corpus/banking_synth.jsonl (regen: scripts/gen_banking_corpus.py)
# GaaS benchmark: VERA_BENCH_MODEL, VERA_BENCH_N (scripts/bench_gaas.py)

# ── Governance-as-a-Service (MVP4 gaas profile; `make stack-gaas`) ──────────────────
# VERA_GAAS_ENABLED=1
# KAFKA_BROKER_URL=redpanda:9092      # empty -> Redis Streams fallback
# OPA_URL=http://opa:8181             # empty -> in-process policy fallback
# OPENSEARCH_URL=http://opensearch:9200  # empty -> signed JSONL audit only
# VERA_GOVERNANCE_MODE=shadow         # shadow | advisory | enforcement
# VERA_CANARY_CRON=0 * * * *
# VERA_PROXY_TARGET_URL=              # empty -> OLLAMA_API_BASE
