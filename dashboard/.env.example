# Guided no-login mode is the default (NEXT_PUBLIC_AUTH_MODE defaults to "guided").
NEXT_PUBLIC_AUTH_MODE=guided
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Enterprise mode (Keycloak RBAC) ─────────────────────────────────────────────────
# NEXT_PUBLIC_AUTH_MODE=enterprise
# NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
# NEXT_PUBLIC_KEYCLOAK_REALM=raip
# NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=raip-dashboard
# Simulate a single role in guided/dev mode:
# NEXT_PUBLIC_DEV_ROLES=legal_compliance,data_scientist,secops
